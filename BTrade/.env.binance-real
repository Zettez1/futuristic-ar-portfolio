# Binance futures config — PAPER trading (simulated fills, no real orders).
# Keys may be injected at runtime from Railway service variables
# (BINANCE_API_KEY / BINANCE_SECRET) for market data — never commit real keys here.
EXCHANGE=binance
BINANCE_API_KEY=
BINANCE_SECRET=
PAPER_TRADING=1
EQUITY=1000
ENTRY_POSITION_PCT=40
MIN_NOTIONAL=5
MAX_MARGIN_FRAC=0.5
SCAN_ALL_SYMBOLS=1
MIN_24H_VOLATILITY=10
MAX_24H_VOLATILITY=200
SCAN_TOP_N=0
SCAN_POOL_WORKERS=12
MA_CROSS_FAST=7
MA_CROSS_SLOW=25
MA_CROSS_MA_TYPE=ema
MA_CROSS_HTF=30m
MA_CROSS_LTF=3m
MA_CROSS_ARM_TIMEOUT_SEC=7200
ENTRY_SL_ATR_MULT=1.5
ENTRY_SL_MIN_PCT=0.3
MA_CROSS_FILTERS=1
MA_CROSS_MAX_2H_MOVE=5
MA_CROSS_MAX_ATR3_PCT=1.2
MA_CROSS_MAX_VOL_RATIO=3
MA_CROSS_MAX_RANGE_POS_LONG=75
MA_CROSS_MAX_24H_MOVE=20
TRAIL_ENABLED=1
TRAIL_BREAK_EVEN_R=0.8
TRAIL_START_R=0.5
TRAIL_DISTANCE_R=0.5
REVERSAL_ENABLED=1
MA_CROSS_REVERSAL_CLOSE_GAP_PCT=0.2
FUTURES=1
MAX_LEVERAGE=15
SCAN_INTERVAL=10
LOCK_PORT=47778
DB_PATH=db/trades_binance.db
MAX_WALLET_USAGE=0.5
MAX_POSITIONS=1
REENTRY_COOLDOWN_SEC=3600
SCHEDULE_ENABLED=1
SCHEDULE_ZONE=Europe/Kyiv
SCHEDULE_WAKE=09:00
SCHEDULE_SLEEP=20:30
SCHEDULE_CLOSE_POSITIONS=1
PAPER_RESET_EQUITY=1
PAPER_NO_DAILY_LIMIT=1
NO_DAILY_LIMIT=1