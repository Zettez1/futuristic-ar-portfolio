# Отдельный конфиг: БУМАЖНАЯ торговля на MEXC (фьючерсы).
# Запуск: scripts\run_mexc_paper.bat  (порт 47777)
# Binance-реал при этом использует свой порт 47778 — оба работают одновременно.
EXCHANGE=mexc
MEXC_API_KEY=mx0vglmqzP9XTspiXb
MEXC_SECRET=7a3c2a9a287048f7b5867edb544d6d59

PAPER_TRADING=1

EQUITY=1000

SYMBOLS=SHIB/USDT:USDT,WLD/USDT:USDT,TIA/USDT:USDT,OP/USDT:USDT,INJ/USDT:USDT,WIF/USDT:USDT
TIMEFRAMES=1m,5m,15m,1h,4h

FUTURES=1
MAX_LEVERAGE=10

SCAN_INTERVAL=20
RETRAIN_INTERVAL=60
MAX_POSITIONS=10

# Свой лок-порт — не конфликтует с Binance-ботом
LOCK_PORT=47777

# Отдельный журнал сделок — не смешивается с реальным Binance (db/trades.db)
DB_PATH=db/trades_mexc.db
